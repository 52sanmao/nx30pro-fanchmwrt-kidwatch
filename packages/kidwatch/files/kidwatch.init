#!/bin/sh /etc/rc.common
# kidwatch 采集服务
USE_PROCD=1
START=96
STOP=12

start_service() {
	config_load kidwatch
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	mkdir -p /tmp/kidwatch /etc/kidwatch
	# dnsmasq 日志文件必须存在，否则 ujail 里打不开
	[ -e /tmp/kidwatch-dnsmasq.log ] || : > /tmp/kidwatch-dnsmasq.log

	/usr/bin/kidwatch init

	procd_open_instance
	procd_set_param command /usr/bin/kidwatch collect
	procd_set_param respawn 3600 5 5
	procd_set_param nice 5
	procd_set_param limits core="0 0"
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger kidwatch
}
