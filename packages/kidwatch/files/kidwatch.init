#!/bin/sh /etc/rc.common
# kidwatch 采集服务
USE_PROCD=1
START=96
STOP=12

start_service() {
	config_load kidwatch
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	mkdir -p /tmp/kidwatch /etc/kidwatch

	# 固件升级会把 fwx 仪表板恢复原版，开机时顺带再套用一次我们的版本；
	# 没装 luci-app-kidwatch 时这个脚本不存在，静默跳过。
	[ -x /usr/lib/kidwatch/dashboard-patch.sh ] && /usr/lib/kidwatch/dashboard-patch.sh >/dev/null 2>&1

	/usr/bin/kidwatch init

	# 主数据源是 fwx 的实时表，这里只是每 3 分钟取一次快照，不再常驻读日志。
	procd_open_instance
	procd_set_param command /usr/bin/kidwatch watch
	procd_set_param respawn 3600 5 5
	procd_set_param nice 10
	procd_set_param limits core="0 0"
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger kidwatch
}
